{
  "name": "portfilio-server",
  "version": "1.0.0",
  "description": "Backend server for Omar Faruk's portfolio website",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon --exec \"node --env-file=.env index.js\"",
     "start": "node index.js",
    "seed:skills": "node --env-file=.env seed/seedSkills.js",
    "seed:projects": "node --env-file=.env seed/projects.seed.js",
    "seed:services": "node --env-file=.env seed/services.seed.js"
  },
  "keywords": [
    "portfolio",
    "mern",
    "node",
    "express",
    "mongodb"
  ],
  "author": "Omar Faruk",
  "license": "ISC",
  "dependencies": {
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.6",
    "express": "^5.2.1",
    "firebase-admin": "^14.5.0",
    "mongodb": "^7.7.0",
    "resend": "^6.32.1"
  },
  "devDependencies": {
    "nodemon": "^3.1.14"
  }
}
